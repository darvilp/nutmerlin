#!/bin/sh

set -eu

program_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
if [ -d "$program_dir/../lib/nutmerlin" ]; then
	library_dir=$program_dir/../lib/nutmerlin
else
	library_dir=$program_dir/../lib
fi

usage() {
	printf '%s\n' 'usage: nutmerlin status [--json]' >&2
	printf '%s\n' '       nutmerlin diagnostics [--json]' >&2
	printf '%s\n' '       nutmerlin service start|stop|restart' >&2
	printf '%s\n' '       nutmerlin source show|use-dummy' >&2
	printf '%s\n' '       nutmerlin source configure-usbhid --vendor-id ID --product-id ID [--serial S | --busport P]' >&2
	printf '%s\n' '       nutmerlin lan configure --address IPv4 --cidr CIDR' >&2
	printf '%s\n' '       nutmerlin lan disable' >&2
	printf '%s\n' '       nutmerlin client add NAME [--json]' >&2
	printf '%s\n' '       nutmerlin client revoke CLIENT_ID' >&2
	printf '%s\n' '       nutmerlin enable|disable|repair|uninstall' >&2
	printf '%s\n' '       nutmerlin update ARCHIVE' >&2
	exit 64
}

[ "$#" -ge 1 ] || usage
command_name=$1
shift

case $command_name in
	status)
		output_format=human
		case $# in
			0) ;;
			1)
				[ "$1" = --json ] || usage
				output_format=json
				;;
			*) usage ;;
		esac
		# The installed core is resolved relative to the CLI.
		# shellcheck disable=SC1091
		. "$library_dir/result.sh"
		result_emit status "$output_format" unavailable unavailable 'NUTMerlin core is not installed'
		exit 69
		;;
	service)
		[ "$#" -eq 1 ] || usage
		service_action=$1
		case $service_action in
			start | stop | restart) ;;
			*) usage ;;
		esac
		# shellcheck disable=SC1091
		. "$library_dir/paths.sh"
		# shellcheck disable=SC1091
		. "$library_dir/entware.sh"
		# shellcheck disable=SC1091
		. "$library_dir/configuration.sh"
		# shellcheck disable=SC1091
		. "$library_dir/ownership.sh"
		# shellcheck disable=SC1091
		. "$library_dir/service.sh"
		paths_initialize
		if [ "$service_action" = stop ]; then
			ownership_verify_code_root "$NUTMERLIN_JFFS_ROOT/addons/nutmerlin" || {
				printf '%s\n' 'service refused: installed code ownership evidence is incomplete' >&2
				exit 78
			}
		else
			ownership_verify_installed_state || {
				printf '%s\n' 'service refused: installed ownership evidence is incomplete' >&2
				exit 78
			}
		fi
		service_run_locked "service_$service_action"
		# shellcheck disable=SC1091
		. "$library_dir/result.sh"
		result_emit service human ok success "$SERVICE_MESSAGE"
		;;
	source)
		if [ "$#" -ne 1 ] || [ "$1" != use-dummy ]; then
			usage
		fi
		# shellcheck disable=SC1091
		. "$library_dir/paths.sh"
		# shellcheck disable=SC1091
		. "$library_dir/entware.sh"
		# shellcheck disable=SC1091
		. "$library_dir/configuration.sh"
		# shellcheck disable=SC1091
		. "$library_dir/ownership.sh"
		# shellcheck disable=SC1091
		. "$library_dir/service.sh"
		paths_initialize
		ownership_verify_installed_state || {
			printf '%s\n' 'source refused: installed ownership evidence is incomplete' >&2
			exit 78
		}
		service_run_locked configuration_activate_dummy
		# shellcheck disable=SC1091
		. "$library_dir/result.sh"
		result_emit source human ok success "$SOURCE_MESSAGE"
		;;
	*) usage ;;
esac
