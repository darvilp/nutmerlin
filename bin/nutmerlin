#!/bin/sh

set -eu

program_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
if [ -d "$program_dir/../lib/nutmerlin" ]; then
	library_dir=$program_dir/../lib/nutmerlin
	installed_layout=0
else
	library_dir=$program_dir/../lib
	installed_layout=1
fi

usage() {
	printf '%s\n' 'usage: nutmerlin status [--json]' >&2
	printf '%s\n' '       nutmerlin diagnostics [--json]' >&2
	printf '%s\n' '       nutmerlin service start|stop|restart' >&2
	printf '%s\n' '       nutmerlin source show|use-dummy' >&2
	printf '%s\n' '       nutmerlin source configure-usbhid --vendor-id ID --product-id ID [--serial S | --busport P]' >&2
	printf '%s\n' '       nutmerlin lan configure --address IPv4 --cidr CIDR' >&2
	printf '%s\n' '       nutmerlin lan disable' >&2
	printf '%s\n' '       nutmerlin client add NAME [--json]' >&2
	printf '%s\n' '       nutmerlin client revoke CLIENT_ID' >&2
	printf '%s\n' '       nutmerlin enable|disable|repair|uninstall' >&2
	printf '%s\n' '       nutmerlin update ARCHIVE' >&2
	exit 64
}

[ "$#" -ge 1 ] || usage
command_name=$1
shift

case $command_name in
	status)
		output_format=human
		case $# in
			0) ;;
			1)
				[ "$1" = --json ] || usage
				output_format=json
				;;
			*) usage ;;
		esac
		if [ "$installed_layout" -ne 1 ]; then
			# shellcheck disable=SC1091
			. "$library_dir/result.sh"
			result_emit status "$output_format" unavailable unavailable 'NUTMerlin core is not installed'
			exit 69
		fi
		# shellcheck disable=SC1091
		. "$library_dir/paths.sh"
		# shellcheck disable=SC1091
		. "$library_dir/entware.sh"
		# shellcheck disable=SC1091
		. "$library_dir/configuration.sh"
		# shellcheck disable=SC1091
		. "$library_dir/hooks.sh"
		# shellcheck disable=SC1091
		. "$library_dir/platform.sh"
		# shellcheck disable=SC1091
		. "$library_dir/ownership.sh"
		# shellcheck disable=SC1091
		. "$library_dir/service.sh"
		# shellcheck disable=SC1091
		. "$library_dir/lifecycle.sh"
		# shellcheck disable=SC1091
		. "$library_dir/status.sh"
		# shellcheck disable=SC1091
		. "$library_dir/result.sh"
		paths_initialize
		status_collect
		result_emit_status status "$output_format" "$STATUS_STATE" "$STATUS_EXIT_CLASS" "$STATUS_MESSAGE" \
			"$STATUS_INSTALLATION" "$STATUS_ENABLED" "$STATUS_STORAGE" "$STATUS_SOURCE" \
			"$STATUS_DRIVER" "$STATUS_UPSD" "$STATUS_UPSC" "$STATUS_LISTENER" "$STATUS_FIREWALL" \
			"$STATUS_CLIENT_COUNT" "$STATUS_RECOVERY" "$STATUS_FAILED_LAYER" "$STATUS_REMEDIATION"
		exit "$STATUS_EXIT"
		;;
	diagnostics)
		output_format=human
		case $# in
			0) ;;
			1)
				[ "$1" = --json ] || usage
				output_format=json
				;;
			*) usage ;;
		esac
		if [ "$installed_layout" -ne 1 ]; then
			# shellcheck disable=SC1091
			. "$library_dir/result.sh"
			result_emit diagnostics "$output_format" unavailable unavailable 'NUTMerlin core is not installed'
			exit 69
		fi
		for status_library in paths entware configuration hooks ownership service platform lifecycle status result; do
			# shellcheck disable=SC1090
			. "$library_dir/$status_library.sh"
		done
		paths_initialize
		status_collect
		result_emit_status diagnostics "$output_format" "$STATUS_STATE" "$STATUS_EXIT_CLASS" "$STATUS_MESSAGE" \
			"$STATUS_INSTALLATION" "$STATUS_ENABLED" "$STATUS_STORAGE" "$STATUS_SOURCE" \
			"$STATUS_DRIVER" "$STATUS_UPSD" "$STATUS_UPSC" "$STATUS_LISTENER" "$STATUS_FIREWALL" \
			"$STATUS_CLIENT_COUNT" "$STATUS_RECOVERY" "$STATUS_FAILED_LAYER" "$STATUS_REMEDIATION"
		exit "$STATUS_EXIT"
		;;
	service)
		[ "$#" -eq 1 ] || usage
		service_action=$1
		case $service_action in
			start | stop | restart) ;;
			*) usage ;;
		esac
		# shellcheck disable=SC1091
		. "$library_dir/paths.sh"
		# shellcheck disable=SC1091
		. "$library_dir/entware.sh"
		# shellcheck disable=SC1091
		. "$library_dir/configuration.sh"
		# shellcheck disable=SC1091
		. "$library_dir/hooks.sh"
		# shellcheck disable=SC1091
		. "$library_dir/platform.sh"
		# shellcheck disable=SC1091
		. "$library_dir/ownership.sh"
		# shellcheck disable=SC1091
		. "$library_dir/service.sh"
		# shellcheck disable=SC1091
		. "$library_dir/lifecycle.sh"
		paths_initialize
		if [ "$service_action" = stop ]; then
			ownership_verify_code_root "$NUTMERLIN_JFFS_ROOT/addons/nutmerlin" || {
				printf '%s\n' 'service refused: installed code ownership evidence is incomplete' >&2
				exit 78
			}
		else
			ownership_verify_installed_state || {
				printf '%s\n' 'service refused: installed ownership evidence is incomplete' >&2
				exit 78
			}
		fi
		service_run_locked "lifecycle_user_$service_action"
		# shellcheck disable=SC1091
		. "$library_dir/result.sh"
		result_emit service human ok success "$LIFECYCLE_MESSAGE"
		;;
	source)
		[ "$#" -ge 1 ] || usage
		source_action=$1
		shift
		case $source_action in
			show | use-dummy) [ "$#" -eq 0 ] || usage ;;
			configure-usbhid) ;;
			*) usage ;;
		esac
		# shellcheck disable=SC1091
		. "$library_dir/paths.sh"
		# shellcheck disable=SC1091
		. "$library_dir/entware.sh"
		# shellcheck disable=SC1091
		. "$library_dir/configuration.sh"
		# shellcheck disable=SC1091
		. "$library_dir/hooks.sh"
		# shellcheck disable=SC1091
		. "$library_dir/platform.sh"
		# shellcheck disable=SC1091
		. "$library_dir/ownership.sh"
		# shellcheck disable=SC1091
		. "$library_dir/service.sh"
		paths_initialize
		ownership_verify_installed_state || {
			printf '%s\n' 'source refused: installed ownership evidence is incomplete' >&2
			exit 78
		}
		case $source_action in
			show) configuration_describe_current_source ;;
			use-dummy) service_run_locked configuration_activate_dummy ;;
			configure-usbhid)
				usb_vendor_id=
				usb_product_id=
				usb_serial=
				usb_busport=
				while [ "$#" -gt 0 ]; do
					usb_option=$1
					shift
					[ "$#" -gt 0 ] || usage
					usb_value=$1
					shift
					case $usb_option in
						--vendor-id)
							[ -z "$usb_vendor_id" ] || usage
							usb_vendor_id=$usb_value
							;;
						--product-id)
							[ -z "$usb_product_id" ] || usage
							usb_product_id=$usb_value
							;;
						--serial)
							[ -z "$usb_serial" ] || usage
							usb_serial=$usb_value
							;;
						--busport)
							[ -z "$usb_busport" ] || usage
							usb_busport=$usb_value
							;;
						*) usage ;;
					esac
				done
				if [ -z "$usb_vendor_id" ] || [ -z "$usb_product_id" ]; then
					usage
				fi
				if { [ -n "$usb_serial" ] && [ -n "$usb_busport" ]; } ||
					{ [ -z "$usb_serial" ] && [ -z "$usb_busport" ]; }; then
					usage
				fi
				usb_vendor_id=$(configuration_normalize_usb_id "$usb_vendor_id") || {
					printf '%s\n' 'source refused: vendor ID must be exactly four hexadecimal digits' >&2
					exit 78
				}
				usb_product_id=$(configuration_normalize_usb_id "$usb_product_id") || {
					printf '%s\n' 'source refused: product ID must be exactly four hexadecimal digits' >&2
					exit 78
				}
				if [ -n "$usb_serial" ]; then
					configuration_serial_is_valid "$usb_serial" || {
						printf '%s\n' 'source refused: serial must be a 1-64 character literal identifier' >&2
						exit 78
					}
					usb_identity_kind=serial
					usb_identity_value=$usb_serial
				else
					usb_busport=$(configuration_normalize_busport "$usb_busport") || {
						printf '%s\n' 'source refused: busport must be a physical port from 1 through 255' >&2
						exit 78
					}
					usb_identity_kind=busport
					usb_identity_value=$usb_busport
				fi
				service_run_locked configuration_activate_usbhid "$usb_vendor_id" \
					"$usb_product_id" "$usb_identity_kind" "$usb_identity_value"
				;;
		esac
		# shellcheck disable=SC1091
		. "$library_dir/result.sh"
		result_emit source human ok success "$SOURCE_MESSAGE"
		;;
	hook)
		[ "$#" -ge 1 ] || usage
		hook_event=$1
		hook_argument=${2:-}
		case $hook_event in
			services-start | services-stop | post-mount | unmount | firewall-start | reconcile) ;;
			*) usage ;;
		esac
		for hook_library in paths entware configuration hooks ownership service platform lifecycle; do
			# shellcheck disable=SC1090
			. "$library_dir/$hook_library.sh"
		done
		paths_initialize
		ownership_verify_code_root "$NUTMERLIN_JFFS_ROOT/addons/nutmerlin" || {
			printf '%s\n' 'hook refused: installed code ownership evidence is incomplete' >&2
			exit 78
		}
		service_run_locked lifecycle_hook "$hook_event" "$hook_argument"
		;;
	*) usage ;;
esac
